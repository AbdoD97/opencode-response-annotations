+import { expect, test } from "bun:test"
+import path from "node:path"
+import { createAppFixture } from "./fixture/app"
+import { tmpdir } from "./fixture/fixture"
+import { directory, json } from "./fixture/tui-client"
+
+const canonical = "Shared instruction\nQuote one\nComment ONE\nQuote two\nComment TWO"
+const source = `export default { id: 'fixture.body', setup(context) {
+  const api = context.ui.messageBody;
+  let release;
+  const register = () => { if (release) return; release = api.register({ name:'fixture.body.v1', present(input) {
+    if (input.metadata?.annotationBatch !== input.source.messageID) return;
+    const range = value => ({ start:input.text.indexOf(value), end:input.text.indexOf(value)+value.length });
+    return { source:input.source, label:'Fixture notes generation 1', items:[
+      { key:'one', label:'#1', preview:range('Quote one'), sections:[{label:'Comment',range:range('Comment ONE')}] },
+      { key:'two', label:'#2', preview:range('Quote two'), sections:[{label:'Comment',range:range('Comment TWO')}] }
+    ] };
+  } }); };
+  register();
+  context.keymap.layer(() => ({ mode:'global', commands:[
+    { id:'fixture.body.remove', bind:'f9', run:()=>{ release?.(); release?.(); release=undefined; } },
+    { id:'fixture.body.add', bind:'f10', run:register }
+  ] }));
+  if (context.options?.fail) throw new Error('Fixture setup failure after registration');
+  return () => release?.();
+} }`
+
+async function mount(root: string, fail = false) {
+  const plugin = path.join(root, "body-plugin")
+  const entry = path.join(plugin, "tui.js")
+  await Bun.write(entry, source)
+  let prompts = 0
+  const session = {
+    id: "ses_test",
+    title: "Body disclosure fixture",
+    projectID: "project",
+    location: { directory },
+    cost: 0,
+    tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+    time: { created: 0, updated: 0 },
+  }
+  const message = {
+    id: "msg_fixture",
+    type: "user",
+    text: canonical,
+    metadata: { annotationBatch: "msg_fixture" },
+    time: { created: 1 },
+  }
+  const setup = await createAppFixture({
+    args: { sessionID: session.id },
+    config: { animations: false, tabs: { mode: "off" }, plugins: [{ package: plugin, options: { fail } }] },
+    fetch: (url, request) => {
+      if (request.method === "POST" && url.pathname.endsWith("/prompt")) {
+        prompts++
+        return json({ message: "No requests allowed" }, { status: 500 })
+      }
+      if (url.pathname === "/api/session") return json({ data: [session], cursor: {} })
+      if (url.pathname === "/api/session/ses_test") return json({ data: session })
+      if (url.pathname === "/api/session/ses_test/message") return json({ data: [message], cursor: {} })
+      if (["/api/session/ses_test/inbox", "/api/session/ses_test/permission"].includes(url.pathname))
+        return json({ data: [] })
+    },
+  })
+  return { setup, entry, prompts: () => prompts }
+}
+
+test("real plugin registration, disposer and hot reload preserve native row actions without prompts", async () => {
+  await using root = await tmpdir()
+  const { setup, entry, prompts } = await mount(root.path)
+  await using app = setup
+  await app.ready
+  await app.waitForFrame((frame) => frame.includes("Fixture notes generation 1"))
+  expect(app.captureCharFrame()).not.toContain("Comment ONE")
+  app.mockInput.pressKey("F9")
+  await app.waitForFrame((frame) => frame.includes("Shared instruction"))
+  app.mockInput.pressKey("F10")
+  await app.waitForFrame((frame) => frame.includes("Fixture notes generation 1"))
+  const frame = app.captureCharFrame().split("\n")
+  const y = frame.findIndex((line) => line.includes("#1"))
+  await app.mockMouse.click(frame[y].indexOf("#1"), y)
+  await app.waitForFrame((frame) => frame.includes("Comment ONE"))
+  expect(app.captureCharFrame()).not.toContain("Message Actions")
+  app.mockInput.pressEscape()
+  // A normal row area retains the native message menu, including body entry.
+  const originalY = app
+    .captureCharFrame()
+    .split("\n")
+    .findIndex((line) => line.includes("Fixture notes generation 1"))
+  await app.mockMouse.click(5, originalY)
+  await app.waitForFrame((frame) => frame.includes("Message Actions"))
+  expect(app.captureCharFrame()).toContain("Focus folded content")
+  expect(app.captureCharFrame()).toContain("Copy")
+  app.mockInput.pressEscape()
+  await Bun.write(entry, source.replace("generation 1", "generation 2"))
+  await app.waitForFrame((frame) => frame.includes("Fixture notes generation 2"))
+  expect(app.captureCharFrame()).not.toContain("Comment ONE")
+  app.mockInput.pressKey("F9")
+  await app.waitForFrame((frame) => frame.includes("Shared instruction"))
+  expect(prompts()).toBe(0)
+})
+
+test("setup failure after registration cannot leave an active body presenter", async () => {
+  await using root = await tmpdir()
+  const { setup, prompts } = await mount(root.path, true)
+  await using app = setup
+  await app.ready
+  await app.waitForFrame((frame) => frame.includes("Shared instruction"))
+  expect(app.captureCharFrame()).not.toContain("Fixture notes generation")
+  app.mockInput.pressKey("F10")
+  await app.renderOnce()
+  expect(app.captureCharFrame()).not.toContain("Fixture notes generation")
+  expect(prompts()).toBe(0)
+})
diff --git a/packages/tui/test/plugin/message-body.test.ts b/packages/tui/test/plugin/message-body.test.ts
new file mode 100644
index 000000000..15227c3ac
--- /dev/null
+++ b/packages/tui/test/plugin/message-body.test.ts
@@ -0,0 +1,92 @@
+import { expect, test } from "bun:test"
+import type { MessageBodyInput, MessageBodyPlan } from "@opencode/plugin/tui/message-body"
+import { bodyDisplay, bodyPreview, resolveMessageBody } from "../../src/plugin/message-body"
+
+const input: MessageBodyInput = { source: { sessionID: "s", messageID: "m", revision: 1 }, text: "A 👨‍👩‍👧 é\r\nComment" }
+const plan = (): MessageBodyPlan => ({
+  source: input.source,
+  label: "Notes (1)",
+  items: [
+    {
+      key: "n",
+      label: "#1",
+      preview: { start: 0, end: input.text.length },
+      sections: [{ label: "Quote", range: { start: 0, end: input.text.length } }],
+    },
+  ],
+})
+const resolve = (value: MessageBodyPlan) =>
+  resolveMessageBody(input, [{ name: "sample.notes.v1", present: () => value }])
+
+test("exact current canonical-body plan is admitted without mutating its input", () => {
+  const before = JSON.stringify(input)
+  expect(resolve(plan())).toEqual(plan())
+  expect(JSON.stringify(input)).toBe(before)
+})
+test("absence, exception and conflicting presenters restore original body", () => {
+  expect(resolveMessageBody(input, [])).toBeUndefined()
+  expect(resolveMessageBody(input, [{ name: "absent", present: () => undefined }])).toBeUndefined()
+  expect(
+    resolveMessageBody(input, [
+      {
+        name: "broken",
+        present: () => {
+          throw new Error("fixture")
+        },
+      },
+    ]),
+  ).toBeUndefined()
+  expect(
+    resolveMessageBody(
+      input,
+      [1, 2].map((n) => ({ name: `plugin.${n}`, present: plan })),
+    ),
+  ).toBeUndefined()
+})
+test("stale body revision, message or session fails closed", () => {
+  for (const source of [
+    { ...input.source, revision: 0 },
+    { ...input.source, messageID: "other" },
+    { ...input.source, sessionID: "other" },
+  ])
+    expect(resolve({ ...plan(), source })).toBeUndefined()
+})
+test("malformed, oversized and duplicate-key plans fail closed", () => {
+  const invalid = [
+    null,
+    {},
+    { ...plan(), label: "x\ncommand" },
+    { ...plan(), items: [] },
+    { ...plan(), items: Array(101).fill(plan().items[0]) },
+    { ...plan(), items: [plan().items[0], plan().items[0]] },
+  ]
+  for (const value of invalid) expect(resolve(value as MessageBodyPlan)).toBeUndefined()
+  let calls = 0
+  expect(
+    resolveMessageBody({ ...input, text: "x".repeat(1_000_001) }, [
+      {
+        name: "fixture",
+        present: () => {
+          calls++
+          return plan()
+        },
+      },
+    ]),
+  ).toBeUndefined()
+  expect(calls).toBe(0)
+})
+test("all range endpoints must be grapheme boundaries and within the canonical text", () => {
+  for (const preview of [
+    { start: -1, end: 1 },
+    { start: 0, end: 100 },
+    { start: 0, end: 0 },
+    { start: 2, end: 3 },
+    { start: 0, end: 2.5 },
+  ])
+    expect(resolve({ ...plan(), items: [{ ...plan().items[0], preview }] })).toBeUndefined()
+})
+test("terminal controls are escaped in local display; previews bound graphemes", () => {
+  expect(bodyDisplay("a\u001b[31m\u202eb\r\n")).toBe("a\\u001b[31m\\u202eb\r\n")
+  expect(bodyPreview("👨‍👩‍👧".repeat(100))).toBe("👨‍👩‍👧".repeat(80) + "…")
+  expect(bodyPreview("A\r\nB")).toBe("A B")
+})
