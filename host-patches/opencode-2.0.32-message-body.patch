diff --git a/packages/plugin/src/tui/message-body.ts b/packages/plugin/src/tui/message-body.ts
new file mode 100644
index 000000000..047b359c1
--- /dev/null
+++ b/packages/plugin/src/tui/message-body.ts
@@ -0,0 +1,35 @@
+/** Local presentation only. Ranges refer to the canonical user-message text,
+ * in UTF-16 code units on grapheme boundaries. No callbacks or JSX in plans. */
+export type MessageBodySource = {
+  readonly sessionID: string
+  readonly messageID: string
+  readonly revision: number
+}
+export type MessageBodyRange = { readonly start: number; readonly end: number }
+export type MessageBodyInput = {
+  readonly source: MessageBodySource
+  readonly text: string
+  readonly metadata?: Readonly<Record<string, unknown>>
+}
+export type MessageBodyPlan = {
+  readonly source: MessageBodySource
+  readonly label: string
+  readonly items: readonly {
+    readonly key: string
+    readonly label: string
+    readonly preview: MessageBodyRange
+    readonly sections: readonly { readonly label: string; readonly range: MessageBodyRange }[]
+  }[]
+}
+export type MessageBodyPresenter = {
+  readonly name: string
+  /** Synchronous Solid computation: may read local reactive state, never submit.
+   * Return undefined for messages this plugin does not own. */
+  readonly present: (input: MessageBodyInput) => MessageBodyPlan | undefined
+}
+export type MessageBodyAPI = {
+  readonly version: 1
+  /** Owned by this plugin; disposed on disable/reload. More than one matching
+   * presenter, invalid output, or an exception restores canonical plain text. */
+  register(presenter: MessageBodyPresenter): () => void
+}
