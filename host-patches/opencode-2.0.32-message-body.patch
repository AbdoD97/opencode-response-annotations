diff --git a/packages/tui/src/component/user-message-body.tsx b/packages/tui/src/component/user-message-body.tsx
new file mode 100644
index 000000000..4ae967d73
--- /dev/null
+++ b/packages/tui/src/component/user-message-body.tsx
@@ -0,0 +1,238 @@
+import { For, Show, createMemo, createSignal, onCleanup } from "solid-js"
+import { BoxRenderable, ScrollBoxRenderable, type MouseEvent, type Renderable } from "@opentui/core"
+import { useRenderer } from "@opentui/solid"
+import type { MessageBodyInput, MessageBodyPresenter } from "@opencode/plugin/tui/message-body"
+import { Keymap } from "../context/keymap"
+import { useTheme } from "../context/theme"
+import { bodyDisplay, bodyPreview, resolveMessageBody } from "../plugin/message-body"
+
+export type MessageBodyControl = { available(): boolean; focus(): void; original(): void }
+
+/** The host owns the body and all interactions. The enclosing native message
+ * row (delivery/actions/files/images) is deliberately outside this component. */
+export function UserMessageBody(props: {
+  sessionID: string
+  messageID: string
+  text: string
+  metadata?: Readonly<Record<string, unknown>>
+  presenters: readonly MessageBodyPresenter[]
+  control?: (value: MessageBodyControl | undefined) => void
+}) {
+  const renderer = useRenderer()
+  const theme = useTheme()
+  let revision = 0
+  const canonical = createMemo(
+    () => ({ sessionID: props.sessionID, messageID: props.messageID, text: props.text }),
+    undefined,
+    {
+      equals: (previous, next) =>
+        previous?.sessionID === next.sessionID && previous.messageID === next.messageID && previous.text === next.text,
+    },
+  )
+  const source = createMemo(() => {
+    // Reading all canonical identity fields invalidates cached plans on edits,
+    // reuse of a mounted row, and pending-to-delivered replacements.
+    const value = canonical()
+    return {
+      source: { sessionID: value.sessionID, messageID: value.messageID, revision: ++revision },
+      text: value.text,
+    }
+  })
+  const plan = createMemo(
+    () => resolveMessageBody({ ...source(), metadata: props.metadata } satisfies MessageBodyInput, props.presenters),
+    undefined,
+    {
+      // Plans contain only bounded host-copied scalar data. Equivalent resyncs
+      // must not remount selected text, lose focus or reset disclosure state.
+      equals: (previous, next) => JSON.stringify(previous) === JSON.stringify(next),
+    },
+  )
+  const identity = createMemo(() => (plan() ? source().source : undefined))
+  const body = createMemo(() => ({
+    identity: identity(),
+    expanded: new Set<string>(),
+    original: false,
+    active: 0,
+    headers: new Map<string, Renderable>(),
+  }))
+  const [change, setChange] = createSignal(0)
+  let root: BoxRenderable | undefined
+  let previous: Renderable | null = null
+  let needsReveal = false
+  let pressed: { x: number; y: number } | undefined
+  const read = () => {
+    change()
+    return body()
+  }
+  const active = () => Math.min(read().active, Math.max(0, (plan()?.items.length ?? 1) - 1))
+  const reveal = () => {
+    if (!root?.focused || renderer.getSelection()?.getSelectedText() || body().original) return
+    const header = body().headers.get(plan()?.items[active()]?.key ?? "")
+    if (!header || header.isDestroyed) return
+    let ancestor = root.parent
+    for (let depth = 0; ancestor && depth < 64; depth++, ancestor = ancestor.parent) {
+      if (!(ancestor instanceof ScrollBoxRenderable)) continue
+      const top = ancestor.viewport.y
+      const bottom = top + ancestor.viewport.height
+      const delta =
+        header.y < top ? header.y - top : header.y + header.height > bottom ? header.y + header.height - bottom : 0
+      if (delta) ancestor.scrollBy({ x: 0, y: delta })
+      return
+    }
+  }
+  const select = (index: number) => {
+    body().active = index
+    needsReveal = true
+    setChange((value) => value + 1)
+  }
+  const focus = () => {
+    if (!root || root.isDestroyed) return
+    if (!root.focused) previous = renderer.currentFocusedRenderable
+    needsReveal = true
+    root.focus()
+  }
+  const restore = () => {
+    if (previous && !previous.isDestroyed) previous.focus()
+    else root?.blur()
+    previous = null
+  }
+  const toggle = (key: string) => {
+    const state = body()
+    if (state.expanded.has(key)) state.expanded.delete(key)
+    else state.expanded.add(key)
+    setChange((value) => value + 1)
+  }
+  const original = () => {
+    body().original = !body().original
+    setChange((value) => value + 1)
+  }
+  const click = (event: MouseEvent, action: () => void) => {
+    const start = pressed
+    pressed = undefined
+    if (
+      event.button !== 0 ||
+      !start ||
+      start.x !== event.x ||
+      start.y !== event.y ||
+      renderer.getSelection()?.getSelectedText()
+    )
+      return
+    event.stopPropagation()
+    action()
+    focus()
+  }
+  Keymap.createLayer(() => ({
+    target: () => root,
+    enabled: !!plan(),
+    priority: 100,
+    commands: [
+      {
+        bind: "return,space",
+        run: () => {
+          const item = plan()?.items[active()]
+          if (item && !body().original) toggle(item.key)
+        },
+      },
+      { bind: "down", run: () => select(Math.min((plan()?.items.length ?? 1) - 1, active() + 1)) },
+      { bind: "up", run: () => select(Math.max(0, active() - 1)) },
+      { bind: "o", run: original },
+      { bind: "escape", run: restore },
+    ],
+  }))
+  props.control?.({ available: () => !!plan(), focus, original })
+  onCleanup(() => {
+    if (root?.focused) restore()
+    props.control?.(undefined)
+  })
+  return (
+    <Show when={plan()} fallback={<text fg={theme.text.base}>{props.text}</text>}>
+      {(presentation) => {
+        onCleanup(() => {
+          if (root?.focused) restore()
+          root = undefined
+        })
+        return (
+          <box
+            id={`message-body:${props.messageID}`}
+            ref={(value) => {
+              root = value
+              value.focusable = true
+            }}
+            onSizeChange={() => {
+              needsReveal = true
+            }}
+            renderAfter={() => {
+              if (needsReveal) {
+                needsReveal = false
+                reveal()
+              }
+            }}
+            flexDirection="column"
+            gap={0}
+          >
+            <text fg={theme.text.muted} selectable={false}>
+              {presentation().label} · ↑↓ select · Enter/Space expand · o original · Esc return
+            </text>
+            <text
+              id={`body-original:${props.messageID}`}
+              fg={theme.text.base}
+              onMouseDown={(event) => {
+                pressed = { x: event.x, y: event.y }
+              }}
+              onMouseUp={(event) => click(event, original)}
+            >
+              {read().original ? "▾ Original message · fold notes" : "▸ Show original message"}
+            </text>
+            <Show
+              when={read().original}
+              fallback={
+                <For each={presentation().items}>
+                  {(item, index) => (
+                    <box flexDirection="column">
+                      <text
+                        id={`body-note:${props.messageID}:${item.key}`}
+                        fg={theme.text.base}
+                        ref={(value) => body().headers.set(item.key, value)}
+                        onMouseDown={(event) => {
+                          pressed = { x: event.x, y: event.y }
+                        }}
+                        onMouseUp={(event) =>
+                          click(event, () => {
+                            select(index())
+                            toggle(item.key)
+                          })
+                        }
+                      >
+                        {`${active() === index() ? ">" : " "} ${read().expanded.has(item.key) ? "▾" : "▸"} ${item.label}  ${bodyPreview(props.text.slice(item.preview.start, item.preview.end))}`}
+                      </text>
+                      <Show when={read().expanded.has(item.key)}>
+                        <box paddingLeft={3} flexDirection="column">
+                          <For each={item.sections}>
+                            {(section) => (
+                              <box flexDirection="column">
+                                <text fg={theme.text.muted} selectable={false}>
+                                  {section.label}
+                                </text>
+                                <text fg={theme.text.base} wrapMode="word">
+                                  {bodyDisplay(props.text.slice(section.range.start, section.range.end))}
+                                </text>
+                              </box>
+                            )}
+                          </For>
+                        </box>
+                      </Show>
+                    </box>
+                  )}
+                </For>
+              }
+            >
+              <text fg={theme.text.base} wrapMode="word">
+                {props.text}
+              </text>
+            </Show>
+          </box>
+        )
+      }}
+    </Show>
+  )
+}
