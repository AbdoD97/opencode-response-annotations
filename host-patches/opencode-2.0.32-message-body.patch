diff --git a/packages/tui/src/plugin/message-body.ts b/packages/tui/src/plugin/message-body.ts
new file mode 100644
index 000000000..fb4c94974
--- /dev/null
+++ b/packages/tui/src/plugin/message-body.ts
@@ -0,0 +1,104 @@
+import type { MessageBodyInput, MessageBodyPlan, MessageBodyPresenter } from "@opencode/plugin/tui/message-body"
+
+export const MESSAGE_BODY_LIMITS = { bytes: 1_000_000, items: 100, sections: 4, label: 160, preview: 80 } as const
+const segmenter = new Intl.Segmenter(undefined, { granularity: "grapheme" })
+
+/** All checks happen at the extension boundary. A failed presenter never hides
+ * canonical text, and registration order cannot choose between competing plans. */
+export function resolveMessageBody(
+  input: MessageBodyInput,
+  presenters: readonly MessageBodyPresenter[],
+): MessageBodyPlan | undefined {
+  if (!presenters.length || input.text.length > MESSAGE_BODY_LIMITS.bytes) return
+  if (new TextEncoder().encode(input.text).byteLength > MESSAGE_BODY_LIMITS.bytes) return
+  let result: MessageBodyPlan | undefined
+  for (const presenter of presenters) {
+    try {
+      const plan = presenter.present(input)
+      if (!plan) continue
+      if (result || !validPlan(input, plan)) return
+      result = {
+        source: { sessionID: plan.source.sessionID, messageID: plan.source.messageID, revision: plan.source.revision },
+        label: plan.label,
+        items: plan.items.map((item) => ({
+          key: item.key,
+          label: item.label,
+          preview: { start: item.preview.start, end: item.preview.end },
+          sections: item.sections.map((section) => ({
+            label: section.label,
+            range: { start: section.range.start, end: section.range.end },
+          })),
+        })),
+      }
+    } catch {
+      return
+    }
+  }
+  return result
+}
+
+function validPlan(input: MessageBodyInput, plan: MessageBodyPlan): boolean {
+  if (!plan || typeof plan !== "object" || !plan.source) return false
+  if (
+    plan.source.sessionID !== input.source.sessionID ||
+    plan.source.messageID !== input.source.messageID ||
+    plan.source.revision !== input.source.revision
+  )
+    return false
+  if (
+    !label(plan.label) ||
+    !Array.isArray(plan.items) ||
+    !plan.items.length ||
+    plan.items.length > MESSAGE_BODY_LIMITS.items
+  )
+    return false
+  const points = new Set(Array.from(segmenter.segment(input.text), (item) => item.index).concat(input.text.length))
+  const range = (value: { start: number; end: number } | undefined) =>
+    !!value &&
+    Number.isInteger(value.start) &&
+    Number.isInteger(value.end) &&
+    value.start >= 0 &&
+    value.end > value.start &&
+    value.end <= input.text.length &&
+    points.has(value.start) &&
+    points.has(value.end)
+  const keys = new Set<string>()
+  return plan.items.every((item) => {
+    if (!item || !label(item.key) || keys.has(item.key) || !label(item.label) || !range(item.preview)) return false
+    keys.add(item.key)
+    return (
+      Array.isArray(item.sections) &&
+      item.sections.length > 0 &&
+      item.sections.length <= MESSAGE_BODY_LIMITS.sections &&
+      item.sections.every(
+        (section: MessageBodyPlan["items"][number]["sections"][number]) =>
+          section && label(section.label) && range(section.range),
+      )
+    )
+  })
+}
+
+function label(value: unknown): value is string {
+  return (
+    typeof value === "string" &&
+    value.length > 0 &&
+    value.length <= MESSAGE_BODY_LIMITS.label &&
+    !/[\r\n\x00-\x1f\x7f-\x9f\u202a-\u202e\u2066-\u2069]/u.test(value)
+  )
+}
+
+export function bodyDisplay(text: string): string {
+  return text.replace(
+    /[\x00-\x08\x0b\x0c\x0e-\x1f\x7f-\x9f\u202a-\u202e\u2066-\u2069]/gu,
+    (value) => `\\u${value.charCodeAt(0).toString(16).padStart(4, "0")}`,
+  )
+}
+
+export function bodyPreview(text: string): string {
+  const result: string[] = []
+  for (const item of segmenter.segment(text)) {
+    if (result.length === MESSAGE_BODY_LIMITS.preview) return bodyDisplay(result.join("").replace(/\s+/gu, " ")) + "…"
+    result.push(item.segment)
+  }
+  return bodyDisplay(result.join("").replace(/\s+/gu, " "))
+}
