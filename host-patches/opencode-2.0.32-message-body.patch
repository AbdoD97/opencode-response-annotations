+import { expect, test } from "bun:test"
+import { type Renderable, TextareaRenderable, ScrollBoxRenderable } from "@opentui/core"
+import { testRender } from "@opentui/solid"
+import { createSignal } from "solid-js"
+import type { MessageBodyPlan, MessageBodyPresenter } from "@opencode/plugin/tui/message-body"
+import { ConfigProvider } from "../../src/config"
+import { Keymap } from "../../src/context/keymap"
+import { ThemeProvider } from "../../src/context/theme"
+import { UserMessageBody, type MessageBodyControl } from "../../src/component/user-message-body"
+import { emptyThemeSource, tmpdir } from "../fixture/fixture"
+import { TestTuiContexts } from "../fixture/tui-environment"
+import { createTuiResolvedConfig } from "../fixture/tui-runtime"
+import { DateTime, Effect } from "effect"
+import { LLM, Message, ToolDefinition } from "@opencode/ai"
+import { OpenAIChat, AnthropicMessages } from "@opencode/ai/protocols"
+import { compileRequest } from "@opencode/ai/route/client"
+import { SessionMessage } from "@opencode/core/session/message"
+import { toLLMMessages } from "@opencode/core/session/runner/to-llm-message"
+import { Model } from "@opencode/core/model"
+import { Provider } from "@opencode/core/provider"
+
+const canonical = "Shared instruction\nQuote one\nComment ONE\nQuote two\nComment TWO"
+const range = (text: string) => ({ start: canonical.indexOf(text), end: canonical.indexOf(text) + text.length })
+const modelRef = Model.Ref.make({ id: Model.ID.make("fixture"), providerID: Provider.ID.make("fixture") })
+async function compiled(text: string) {
+  const user = SessionMessage.User.make({
+    id: SessionMessage.ID.make("msg_fixture"),
+    type: "user",
+    text,
+    metadata: { annotationBatch: "msg_fixture" },
+    time: { created: DateTime.makeUnsafe(0) },
+  })
+  return Effect.runPromise(
+    Effect.gen(function* () {
+      const result = []
+      for (const model of [
+        OpenAIChat.route.model({ id: "gpt-4.1-mini" }),
+        AnthropicMessages.route.model({ id: "claude-sonnet-4" }),
+      ]) {
+        const prepared = yield* compileRequest(
+          LLM.request({
+            model,
+            system: "Existing system text",
+            cache: "auto",
+            messages: [
+              Message.user("Earlier question"),
+              Message.assistant("Earlier answer"),
+              ...toLLMMessages([user], modelRef),
+            ],
+            tools: [
+              ToolDefinition.make({
+                name: "existing_tool",
+                description: "Existing tool",
+                inputSchema: { type: "object" },
+              }),
+            ],
+          }),
+        )
+        result.push(prepared.body)
+      }
+      return result
+    }),
+  )
+}
+const presenter: MessageBodyPresenter = {
+  name: "fixture.notes.v1",
+  present: (input) => ({
+    source: input.source,
+    label: "Notes (2)",
+    items: [
+      {
+        key: "one",
+        label: "#1",
+        preview: range("Quote one"),
+        sections: [
+          { label: "Quote", range: range("Quote one") },
+          { label: "Comment", range: range("Comment ONE") },
+        ],
+      },
+      {
+        key: "two",
+        label: "#2",
+        preview: range("Quote two"),
+        sections: [{ label: "Comment", range: range("Comment TWO") }],
+      },
+    ],
+  }),
+}
+
+function find(node: Renderable, id: string): Renderable | undefined {
+  return node.id === id
+    ? node
+    : node
+        .getChildren()
+        .map((child) => find(child, id))
+        .find(Boolean)
+}
+async function mount(directory: string, width = 100, fixture = { text: canonical, presenter }) {
+  let presentations = 0
+  const counted: MessageBodyPresenter = {
+    name: fixture.presenter.name,
+    present: (input) => {
+      presentations++
+      return fixture.presenter.present(input)
+    },
+  }
+  const [presenters, setPresenters] = createSignal<readonly MessageBodyPresenter[]>([counted])
+  const [canonicalValue, setCanonicalValue] = createSignal({ text: fixture.text })
+  const text = () => canonicalValue().text
+  const setText = (value: string) => setCanonicalValue({ text: value })
+  const [metadata, setMetadata] = createSignal<Readonly<Record<string, unknown>>>({ annotationBatch: "m" })
+  let control: MessageBodyControl | undefined
+  let composer!: TextareaRenderable
+  let scroll!: ScrollBoxRenderable
+  let menus = 0
+  const app = await testRender(
+    () => (
+      <TestTuiContexts directory={directory} paths={{ home: directory, state: directory, worktree: directory }}>
+        <ConfigProvider config={createTuiResolvedConfig()}>
+          <Keymap.Provider>
+            <ThemeProvider mode="dark" source={emptyThemeSource}>
+              <box flexDirection="column" width="100%" height="100%">
+                <scrollbox ref={scroll} height={24} width="100%" scrollY>
+                  <box
+                    id="native-row"
+                    onMouseUp={() => {
+                      if (!app.renderer.getSelection()?.getSelectedText()) menus++
+                    }}
+                  >
+                    <UserMessageBody
+                      sessionID="s"
+                      messageID="m"
+                      text={text()}
+                      metadata={metadata()}
+                      presenters={presenters()}
+                      control={(value) => {
+                        control = value
+                      }}
+                    />
+                    <text>Native file badge</text>
+                  </box>
+                </scrollbox>
+                <textarea ref={composer} initialValue="UNSENT DRAFT" height={2} />
+              </box>
+            </ThemeProvider>
+          </Keymap.Provider>
+        </ConfigProvider>
+      </TestTuiContexts>
+    ),
+    { width, height: 32, kittyKeyboard: true },
+  )
+  await app.renderOnce()
+  composer.focus()
+  await app.waitForFrame((frame) =>
+    frame.includes(
+      fixture.presenter.present({ source: { sessionID: "s", messageID: "m", revision: 1 }, text: fixture.text })!.label,
+    ),
+  )
+  return {
+    ...app,
+    control: () => control!,
+    composer,
+    scroll,
+    menus: () => menus,
+    setPresenters,
+    setText,
+    setMetadata,
+    presentations: () => presentations,
+    compiled: () => compiled(text()),
+    node: (id: string) => find(app.renderer.root, id)!,
+  }
+}
+
+test.each([100, 44])(
+  "individual default collapse, keyboard toggle/original/Escape, resize at %i columns",
+  async (width) => {
+    await using tmp = await tmpdir()
+    const app = await mount(tmp.path, width)
+    try {
+      const before = await app.compiled()
+      expect(app.captureCharFrame()).toContain("#1")
+      expect(app.captureCharFrame()).toContain("#2")
+      expect(app.captureCharFrame()).not.toContain("Comment ONE")
+      expect(app.renderer.currentFocusedRenderable).toBe(app.composer)
+      app.control().focus()
+      app.mockInput.pressEnter()
+      await app.renderOnce()
+      expect(app.captureCharFrame()).toContain("Comment ONE")
+      expect(app.captureCharFrame()).not.toContain("Comment TWO")
+      app.mockInput.pressArrow("down")
+      app.mockInput.pressKey(" ")
+      await app.renderOnce()
+      expect(app.captureCharFrame()).toContain("Comment TWO")
+      app.resize(60, 32)
+      await app.renderOnce()
+      expect(app.captureCharFrame()).toContain("Comment ONE")
+      app.mockInput.pressKey("o")
+      await app.renderOnce()
+      expect(app.captureCharFrame()).toContain("Shared instruction")
+      app.mockInput.pressKey("o")
+      app.mockInput.pressEscape()
+      await app.renderOnce()
+      expect(app.renderer.currentFocusedRenderable).toBe(app.composer)
+      expect(app.composer.plainText).toBe("UNSENT DRAFT")
+      expect(app.menus()).toBe(0)
+      expect(await app.compiled()).toEqual(before)
+    } finally {
+      app.renderer.destroy()
+    }
+  },
+)
+
+test("equivalent resync preserves expanded selected text and focus; idle frames never rerun presenters", async () => {
+  await using tmp = await tmpdir()
+  const app = await mount(tmp.path)
+  try {
+    app.control().focus()
+    app.mockInput.pressEnter()
+    await app.flush()
+    const lines = app.captureCharFrame().split("\n")
+    const y = lines.findIndex((line) => line.includes("Comment ONE"))
+    const x = lines[y].indexOf("Comment ONE")
+    await app.mockMouse.drag(x, y, x + 6, y)
+    const selected = app.renderer.getSelection()?.selectedRenderables[0]
+    const focused = app.renderer.currentFocusedRenderable
+    expect(app.renderer.getSelection()?.getSelectedText()).toContain("Comment")
+    app.setText(canonical) // A replacement object with identical canonical fields.
+    app.setMetadata({ annotationBatch: "m", displayGeneration: 2 })
+    await app.flush()
+    expect(app.captureCharFrame()).toContain("Comment ONE")
+    expect(app.renderer.getSelection()?.selectedRenderables[0]).toBe(selected)
+    expect(app.renderer.getSelection()?.getSelectedText()).toContain("Comment")
+    expect(app.renderer.currentFocusedRenderable).toBe(focused)
+    const calls = app.presentations()
+    for (let index = 0; index < 20; index++) {
+      app.renderer.requestRender()
+      await app.renderOnce()
+    }
+    expect(app.presentations()).toBe(calls)
+    expect(app.menus()).toBe(0)
+  } finally {
+    app.renderer.destroy()
+  }
+})
+
+test("bounded many-note keyboard navigation reveals the selected header in the native scrollbox", async () => {
+  await using tmp = await tmpdir()
+  const text = Array.from({ length: 60 }, (_, index) => `Quote ${index}\nComment ${index}`).join("\n")
+  const many: MessageBodyPresenter = {
+    name: "fixture.many",
+    present: (input) => ({
+      source: input.source,
+      label: "Many notes",
+      items: Array.from({ length: 60 }, (_, index) => {
+        const quote = `Quote ${index}`
+        const start = input.text.indexOf(quote + "\n")
+        return {
+          key: `n${index}`,
+          label: `#${index}`,
+          preview: { start, end: start + quote.length },
+          sections: [{ label: "Quote", range: { start, end: start + quote.length } }],
+        }
+      }),
+    }),
+  }
+  const app = await mount(tmp.path, 44, { text, presenter: many })
+  try {
+    app.control().focus()
+    for (let index = 0; index < 40; index++) app.mockInput.pressArrow("down")
+    await app.flush()
+    expect(app.scroll.scrollTop).toBeGreaterThan(0)
+    expect(app.captureCharFrame()).toContain("> ▸ #40")
+    app.mockInput.pressEnter()
+    await app.flush()
+    expect(app.captureCharFrame()).toContain("> ▾ #40")
+    const top = app.scroll.scrollTop
+    app.resize(60, 32)
+    await app.flush()
+    expect(app.captureCharFrame()).toContain("#40")
+    expect(app.scroll.scrollTop).toBe(top)
+  } finally {
+    app.renderer.destroy()
+  }
+})
+
+test("handled mouse toggles stay inside the body; expanded content selection and native row actions survive", async () => {
+  await using tmp = await tmpdir()
+  const app = await mount(tmp.path)
+  try {
+    const note = app.node("body-note:m:one")
+    await app.mockMouse.click(note.x + 3, note.y)
+    await app.renderOnce()
+    expect(app.captureCharFrame()).toContain("Comment ONE")
+    expect(app.menus()).toBe(0)
+    const frame = app.captureCharFrame().split("\n")
+    const commentY = frame.findIndex((line) => line.includes("Comment ONE"))
+    const commentX = frame[commentY].indexOf("Comment ONE")
+    await app.mockMouse.drag(commentX, commentY, commentX + 6, commentY)
+    expect(app.renderer.getSelection()?.getSelectedText()).toContain("Comment")
+    expect(app.menus()).toBe(0)
+    app.renderer.clearSelection()
+    const badgeY = app
+      .captureCharFrame()
+      .split("\n")
+      .findIndex((line) => line.includes("Native file badge"))
