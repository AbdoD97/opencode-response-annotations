{
  "name": "opencode-response-annotations",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Native transcript selection and queued sidebar annotations for OpenCode V2 CLI",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "PARITY.md",
    "VALIDATION.md",
    "PERFORMANCE.md",
    "STORAGE.md",
    "PRESENTATION.md",
    "REFERENCE-BEHAVIOR.md",
    "script/manage-annotation-store.ts",
    "script/store-file.ts",
    "tui.js"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:panel": "bun test --preload @opentui/solid/preload test/panel.test.tsx test/review-edge-cases.test.tsx test/native-selection.test.tsx test/performance-lifecycle.test.tsx test/comment-dialog.test.tsx",
    "test:host": "bun test --preload @opentui/solid/preload test/host-storage.test.tsx test/client-request.test.tsx",
    "build": "bun run script/build.ts",
    "benchmark": "node script/benchmark-annotations.ts",
    "benchmark:storage": "node script/benchmark-storage.ts"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/client": "2.0.32",
    "@opencode/plugin": "2.0.32",
    "@opencode/util": "2.0.32",
    "@opentui/core": "0.5.17",
    "@opentui/keymap": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/bun": "^1.3.11",
    "@types/node": "24.10.1",
    "bun": "^1.4.3",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  }
}
